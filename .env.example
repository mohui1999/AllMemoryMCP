# Nested map of tenant -> {agent id -> bearer token}. Single-tenant setups use "default".
# Replace both example values before use.
AGENT_TOKENS={"default":{"codex":"replace-with-a-long-random-token","cursor":"replace-with-another-long-random-token"}}
DATABASE_PATH=./data/memory.db
DATABASE_URL=sqlite:///./data/memory.db
MCP_HOST=0.0.0.0
MCP_PORT=8001
MCP_TRANSPORT=streamable-http
# For a local stdio bridge only; provision one process per Agent.
# MCP_AGENT_ID=codex
# MCP_TENANT_ID=default
# Admin token for the credential-management endpoints (ADMIN_TOKENS = {admin_name: token}).
# ADMIN_TOKENS={"admin":"replace-with-a-long-random-token"}
