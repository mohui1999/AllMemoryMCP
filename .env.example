# Nested map of tenant -> {agent id -> bearer token}. Single-tenant setups use "default".
# Replace both example values before use.
AGENT_TOKENS={"default":{"codex":"replace-with-a-long-random-token","cursor":"replace-with-another-long-random-token"}}
DATABASE_PATH=./data/memory.db
DATABASE_URL=sqlite:///./data/memory.db
MCP_HOST=0.0.0.0
MCP_PORT=8001
MCP_TRANSPORT=streamable-http
# Vector retrieval works on the default SQLite deployment too.
#   local  = offline hashing vectors, zero dependencies, no API key (default)
#   openai = semantic vectors, also supports OpenAI-compatible endpoints
#   none   = keyword search only
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=1536
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=replace-with-your-key
# OPENAI_EMBED_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=https://your-embedding-gateway/v1
# After changing the provider/model, rebuild vectors with POST /v1/admin/reindex.
# For a local stdio bridge only; provision one process per Agent.
# MCP_AGENT_ID=codex
# MCP_TENANT_ID=default
# Admin token for the unified browser console + credential-management endpoints.
# One account: the same sign-in can browse memories, delete them and manage Agents.
# ADMIN_TOKENS={"admin":"replace-with-a-long-random-token"}
# Browser session: the admin token is stored in an HttpOnly SameSite=Lax cookie.
# WEB_SESSION_TTL=2592000          # seconds; default 30 days, range 300..31536000
# WEB_ADMIN_TENANT=default        # tenant whose memories the console browses
# WEB_COOKIE_SECURE=auto          # auto|true|false; set true behind an HTTPS proxy
