# Production environment for AllMemoryMCP.
# Copy to `.env` and replace every placeholder with a strong random value.
# Generate a token: python -c "import secrets;print(secrets.token_urlsafe(48))"

# --- Agent credentials (static tokens, MVP) ---------------------------------
# Nested map: tenant_id -> {agent_id -> token}. Use a distinct tenant per org/user.
AGENT_TOKENS={"default":{"codex":"REPLACE_WITH_LONG_RANDOM_TOKEN","cursor":"REPLACE_WITH_ANOTHER_LONG_RANDOM_TOKEN"}}

# --- Storage ----------------------------------------------------------------
# SQLite default (single file on the ./data bind mount) — light enough for the
# memory-constrained single host. PostgreSQL is optional (see below).
DATABASE_PATH=/data/memory.db
DATABASE_URL=sqlite:////data/memory.db
# PostgreSQL alternative (uncomment the postgres service in docker-compose.yml
# and set this instead), or point at an existing server DB:
# DATABASE_URL=postgresql+psycopg://allmemory:CHANGE_ME@postgres:5432/allmemory

# --- Semantic search (optional) ---------------------------------------------
# Off by default (keyword LIKE). To enable: use PostgreSQL+pgvector AND set
# EMBEDDING_PROVIDER=openai + OPENAI_API_KEY. No local model is loaded.
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_EMBED_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536

# --- MCP server -------------------------------------------------------------
MCP_HOST=0.0.0.0
MCP_PORT=8001
MCP_TRANSPORT=streamable-http

# --- Admin / credential management ------------------------------------------
# Static admin token protecting /v1/admin/credentials (issue/revoke/rotate agent
# tokens at runtime). ADMIN_TOKENS = {admin_name: token}.
ADMIN_TOKENS={"admin":"REPLACE_WITH_LONG_RANDOM_TOKEN"}
